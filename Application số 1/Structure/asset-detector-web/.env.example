# Copy to .env.local for local development. No real values here.

# Figma personal access token (read access to the design files)
FIGMA_TOKEN=
# GitHub token used to publish/fetch repos
GITHUB_TOKEN=
# GitHub organisation that owns the repos
GITHUB_ORG=
# Branch used when publishing/fetching
GITHUB_BRANCH=
# Where templates come from: live | snapshot
TEMPLATE_SOURCE=live
# Base folder for the tool's working data when the folders below are not set (default ./data, git-ignored)
APP_DATA_DIR=
# Root folder of game template repos. Default: ../game-template-repo if it exists, else $APP_DATA_DIR/templates
TEMPLATE_ROOT=
# Folder holding frozen template snapshots (default: ../template-store if it exists, else $APP_DATA_DIR/template-store)
TEMPLATE_STORE_DIR=
# Folder for materialized templates (default: ../template-materialized if it exists, else $APP_DATA_DIR/cache)
TEMPLATE_CACHE_DIR=
# Folder for clone detect schemas (default: ../clone-schemas if it exists, else $APP_DATA_DIR/clone-schemas)
CLONE_SCHEMAS_DIR=
# Folder with template registry manifests (default ./template-registry)
TEMPLATE_REGISTRY_DIR=
# Token used by git when fetching template repos (empty = no auth)
TEMPLATE_GIT_TOKEN=
# Git username paired with TEMPLATE_GIT_TOKEN (default oauth2)
TEMPLATE_GIT_USER=oauth2
# Extra origins allowed to open the dev server, comma separated
ALLOWED_DEV_ORIGINS=
