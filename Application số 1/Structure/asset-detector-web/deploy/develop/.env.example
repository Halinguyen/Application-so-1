# Copied to ./.env by the Docker build (ARG DEPLOY=develop). Overridden at runtime by the ConfigMap.
# Tokens stay EMPTY here: they come from the Kubernetes Secret (see deploy.yaml).
FIGMA_TOKEN=
GITHUB_TOKEN=
TEMPLATE_GIT_TOKEN=
GITHUB_ORG=
GITHUB_BRANCH=
TEMPLATE_SOURCE=live
TEMPLATE_GIT_USER=oauth2
# Paths on the PersistentVolume mounted at /data
TEMPLATE_ROOT=/data/templates
TEMPLATE_STORE_DIR=/data/template-store
TEMPLATE_CACHE_DIR=/data/cache
CLONE_SCHEMAS_DIR=/data/clone-schemas
# Registry manifests ship inside the image
TEMPLATE_REGISTRY_DIR=./template-registry
ALLOWED_DEV_ORIGINS=
